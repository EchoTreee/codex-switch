#!/usr/bin/env bash
# codex-switch — Codex 多账号登录切换器
#
# 原理：Codex 的登录态 = ~/.codex/auth.json（OAuth token 或 API key）
#                             + ~/.codex/config.toml（model_provider / base_url）。
#       对话记录存本地 ~/.codex/sessions/，跟账号无关，换账号不会丢。
#       每个 profile 存成目录：auth.json + config.toml，一键备份 / 切换 / 查看。
#
# 用法：
#   codex-switch save <名字>       把当前登录态 + 配置存成 profile
#   codex-switch use  <名字>       切换到某个 profile（自动备份当前到 previous.*）
#   codex-switch relogin <名字>    重新登录后存成 profile（在隔离的临时 home 里登录，不影响其它会话；加 --device-auth 用设备码）
#   codex-switch run  <名字>       用独立 CODEX_HOME 启动 codex（多账号并发不串号，[codex 参数] 透传）
#   codex-switch sync <名字>       把独立 CODEX_HOME（run 出来的）的最新登录态回写进 profile
#   codex-switch daemon-restart <名字>  停掉该 home 缓存旧登录态的 app-server daemon（relogin 后仍弹登录页时用）
#   codex-switch list              列出所有 profile 和当前登录的账号
#   codex-switch sessions          列出所有会话（id+provider+标题），方便 codex resume <id>
#   codex-switch resume <关键词|ID>   按标题关键词或会话 ID 恢复，自动用当前 provider/model（跨 provider 恢复）
#   codex-switch status            查看当前登录态与配置
#   codex-switch delete <名字>     删除某个 profile
#   codex-switch help              显示帮助
#
# 注意：
#   - 切换账号不要用 codex logout —— logout 会在服务器端吊销 refresh token，
#     导致已保存的 profile 失效。切换直接用 codex-switch use。
#   - 中转站（自定义 base_url 的 provider）的 API key 走 OPENAI_API_KEY 环境变量，
#     需要你在 .bashrc / .profile 里 export 好，本脚本只负责切换 config.toml。
#
# 环境变量：
#   CODEX_HOME          codex 配置目录（默认 ~/.codex）
#   CODEX_SWITCH_DIR    profile 存放目录（默认 ~/.config/codex-switch）

set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
AUTH_FILE="$CODEX_HOME/auth.json"
CONFIG_FILE="$CODEX_HOME/config.toml"
STORE_DIR="${CODEX_SWITCH_DIR:-$HOME/.config/codex-switch}"
PROFILES_DIR="$STORE_DIR/profiles"
CURRENT_FILE="$STORE_DIR/current"
HOMES_DIR="${CODEX_SWITCH_HOMES_DIR:-$HOME/.codex-homes}"

# 从 auth.json 提取 account_id 和登录方式，输出 "account_id|mode"
info() {
  local f="$1"
  [ -f "$f" ] || { echo "?|missing"; return; }
  python3 - "$f" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    t = d.get("tokens") or {}
    aid = t.get("account_id") or d.get("account_id") or "?"
    mode = d.get("auth_mode") or ("api-key" if d.get("OPENAI_API_KEY") else "?")
    print(f"{aid}|{mode}")
except Exception:
    print("?|parse-error")
PY
}

aid_of()  { info "$1" | cut -d'|' -f1; }
mode_of() { info "$1" | cut -d'|' -f2; }

# 从 config.toml 提取 model_provider（缺省按 codex 默认 openai）
cfg_provider() {
  local f="$1" v=""
  [ -f "$f" ] || { echo "?"; return; }
  v="$(grep -E '^model_provider[[:space:]]*=' "$f" 2>/dev/null | head -1 | sed -E 's/.*=[[:space:]]*"([^"]*)"/\1/')"
  echo "${v:-openai}"
}

# 从 config.toml 提取 base_url（中转站用）
cfg_base_url() {
  local f="$1" v=""
  [ -f "$f" ] || { echo "?"; return; }
  v="$(grep -E '^base_url[[:space:]]*=' "$f" 2>/dev/null | head -1 | sed -E 's/.*=[[:space:]]*"([^"]*)"/\1/')"
  echo "${v:-?}"
}

# 从 config.toml 提取 model
cfg_model() {
  local f="$1" v=""
  [ -f "$f" ] || { echo "?"; return; }
  v="$(grep -E '^model[[:space:]]*=' "$f" 2>/dev/null | head -1 | sed -E 's/.*=[[:space:]]*"([^"]*)"/\1/')"
  echo "${v:-?}"
}

die() { echo "错误：$*" >&2; exit 1; }

# 找出某个 home 正在运行的 app-server daemon / pid-update-loop 进程 PID。
# codex 的 daemon 只在启动时读一次 auth.json，之后把 token 链缓存在内存里：
# relogin/sync 只更新磁盘文件，旧 daemon 继续用死链打 API（401），run 就会弹登录页。
# 只匹配 cmdline 含 "app-server --listen" 或 "pid-update-loop"、且 environ 里
# CODEX_HOME 精确等于目标 home 的进程，避免误杀 TUI 或其它 home 的进程。
home_daemon_pids() {
  local home="$1" p args env_line
  [ -d /proc ] || return 0
  for p in /proc/[0-9]*; do
    [ -r "$p/cmdline" ] || continue
    args="$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null || true)"
    case "$args" in
      *"app-server --listen"*|*"pid-update-loop"*) ;;
      *) continue ;;
    esac
    [ -r "$p/environ" ] || continue
    env_line="$(tr '\0' '\n' < "$p/environ" 2>/dev/null | grep -Fx "CODEX_HOME=$home" | head -1 || true)"
    [ -n "$env_line" ] && echo "${p#/proc/}"
  done
}

cmd_help() {
  sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
}

cmd_save() {
  [ $# -eq 1 ] || die "用法：codex-switch save <名字>"
  local name="$1"
  local d="$PROFILES_DIR/$name"
  [ -f "$AUTH_FILE" ]   || die "没有找到 ${AUTH_FILE}，请先 codex login 登录"
  [ -f "$CONFIG_FILE" ] || die "没有找到 $CONFIG_FILE"
  mkdir -p "$d"
  cp "$AUTH_FILE"   "$d/auth.json"
  cp "$CONFIG_FILE" "$d/config.toml"
  echo "$name" > "$CURRENT_FILE"
  echo "已保存 profile「${name}」  provider=$(cfg_provider "$CONFIG_FILE")  account_id=$(aid_of "$AUTH_FILE")  mode=$(mode_of "$AUTH_FILE")"
}

cmd_use() {
  [ $# -eq 1 ] || die "用法：codex-switch use <名字>"
  local name="$1"
  local d="$PROFILES_DIR/$name"
  [ -f "$d/auth.json" ] || die "profile「${name}」不存在（可用 codex-switch list 查看）"

  # 切走前：把当前登录态 + 配置刷新回「当前」profile（CURRENT_FILE 记录的那个）
  local curprof=""
  [ -f "$CURRENT_FILE" ] && curprof="$(cat "$CURRENT_FILE")"
  if [ -n "$curprof" ] && [ -d "$PROFILES_DIR/$curprof" ] && [ "$curprof" != "$name" ]; then
    if [ -f "$AUTH_FILE" ]; then
      cp "$AUTH_FILE" "$PROFILES_DIR/$curprof/auth.json"
      [ -f "$CONFIG_FILE" ] && cp "$CONFIG_FILE" "$PROFILES_DIR/$curprof/config.toml"
      echo "已把当前登录态刷新回 profile「${curprof}」"
    fi
  fi

  # 同时备份一份，方便切错时恢复
  mkdir -p "$STORE_DIR"
  if [ -f "$AUTH_FILE" ]; then
    cp "$AUTH_FILE" "$STORE_DIR/previous.auth.json"
    [ -f "$CONFIG_FILE" ] && cp "$CONFIG_FILE" "$STORE_DIR/previous.config.toml"
    echo "已把当前登录态备份到 $STORE_DIR/previous.*"
  fi

  mkdir -p "$(dirname "$AUTH_FILE")"
  cp "$d/auth.json" "$AUTH_FILE"
  [ -f "$d/config.toml" ] && cp "$d/config.toml" "$CONFIG_FILE"
  echo "$name" > "$CURRENT_FILE"
  echo "已切换到「${name}」  provider=$(cfg_provider "$CONFIG_FILE")  account_id=$(aid_of "$AUTH_FILE")  mode=$(mode_of "$AUTH_FILE")"

  if command -v codex >/dev/null 2>&1; then
    echo "--- codex login status ---"
    codex login status 2>&1 || true
  fi
  echo "提示：若上方提示 refresh token revoked/expired，说明该 profile 登录态已失效；"
  echo "      请用 codex-switch relogin <名字> 重新登录刷新（不要用 codex logout）。"
}

cmd_relogin() {
  local device_auth=""
  if [ "${1:-}" = "--device-auth" ]; then
    device_auth="1"
    shift
  fi
  [ $# -eq 1 ] || die "用法：codex-switch relogin [--device-auth] <名字>"
  local name="$1"
  local d="$PROFILES_DIR/$name"
  command -v codex >/dev/null 2>&1 || die "找不到 codex 命令"
  # 登录必须在临时空 home 里执行，不能在共享 CODEX_HOME 里跑：
  # codex login 会先吊销当前 home 的 refresh_token。在共享 home 里登录，
  # 上一次 relogin 留下的会话（可能正被 run 出来的并发槽位使用）会被当作旧会话吊销。
  scratch="$(mktemp -d "${TMPDIR:-/tmp}/codex-switch-login.XXXXXX")" || die "无法创建临时目录"
  trap 'rm -rf "$scratch" 2>/dev/null || true' EXIT
  # 带上一份 config.toml：优先该 profile 已有的（保持 provider 一致），否则沿用共享 home 的。
  if [ -f "$d/config.toml" ]; then
    cp "$d/config.toml" "$scratch/config.toml"
  elif [ -f "$CONFIG_FILE" ]; then
    cp "$CONFIG_FILE" "$scratch/config.toml"
  fi
  if [ -n "$device_auth" ]; then
    echo "即将在隔离的临时 home 里用设备码登录（不影响其它正在运行的会话），请选择「${name}」对应的账号。"
    CODEX_HOME="$scratch" codex login --device-auth || die "codex login 失败"
  else
    echo "即将在隔离的临时 home 里用浏览器登录（不影响其它正在运行的会话），请选择「${name}」对应的账号（建议无痕窗口）。"
    CODEX_HOME="$scratch" codex login || die "codex login 失败"
  fi
  [ -f "$scratch/auth.json" ] || die "登录后没有生成 $scratch/auth.json"
  mkdir -p "$d"
  cp "$scratch/auth.json" "$d/auth.json"
  # config.toml：profile 没有时才补一份；共享 home 的 auth/config 原样保留，不再被动
  if [ ! -f "$d/config.toml" ] && [ -f "$CONFIG_FILE" ]; then
    cp "$CONFIG_FILE" "$d/config.toml"
  fi
  echo "$name" > "$CURRENT_FILE"
  echo "已重新登录并保存为「${name}」  provider=$(cfg_provider "$d/config.toml")  account_id=$(aid_of "$d/auth.json")  mode=$(mode_of "$d/auth.json")"

  # 磁盘上的新 token 对已在运行的旧 daemon 无效：它只在启动时读过一次 auth.json。
  # 该 profile 的独立 home 里有旧 daemon 时提醒重启，否则 run 时可能仍弹登录页。
  local hpids
  hpids="$(home_daemon_pids "$HOMES_DIR/$name")"
  if [ -n "$hpids" ]; then
    echo "注意：「${name}」的独立 home 里有旧 app-server daemon 还在运行（PID: $(printf '%s' "$hpids" | tr '\n' ' ')），它缓存的还是旧登录态。"
    echo "      run 之前请先执行：codex-switch daemon-restart ${name}"
  fi
}

cmd_list() {
  echo "profile 目录：$PROFILES_DIR"
  if [ ! -d "$PROFILES_DIR" ] || [ -z "$(ls -A "$PROFILES_DIR" 2>/dev/null)" ]; then
    echo "  （还没有任何 profile，用 codex-switch save <名字> 保存）"
  else
    local cur=""
    [ -f "$CURRENT_FILE" ] && cur="$(cat "$CURRENT_FILE")"
    local p
    for p in "$PROFILES_DIR"/*/; do
      [ -d "$p" ] || continue
      local pa="${p%/}/auth.json"
      local pc="${p%/}/config.toml"
      [ -f "$pa" ] || continue
      local n; n="$(basename "$p")"
      local prov; prov="$(cfg_provider "$pc")"
      local idline
      if [ "$prov" = "openai" ]; then
        idline="account_id=$(aid_of "$pa")  mode=$(mode_of "$pa")"
      else
        idline="base_url=$(cfg_base_url "$pc")"
      fi
      local mark=" "
      [ "$n" = "$cur" ] && mark="*"
      printf "  %s %-14s provider=%-8s %s\n" "$mark" "$n" "$prov" "$idline"
    done
  fi
  echo "当前：provider=$(cfg_provider "$CONFIG_FILE")  account_id=$( [ -f "$AUTH_FILE" ] && aid_of "$AUTH_FILE" || echo '无' )"
}

cmd_status() {
  echo "auth.json   位置：$AUTH_FILE"
  echo "config.toml 位置：$CONFIG_FILE"
  echo "  当前 provider：$(cfg_provider "$CONFIG_FILE")"
  if [ -f "$AUTH_FILE" ]; then
    echo "  当前账号：account_id=$(aid_of "$AUTH_FILE")  mode=$(mode_of "$AUTH_FILE")"
    echo "  文件时间：$(stat -c '%y' "$AUTH_FILE" 2>/dev/null || echo '?')"
  else
    echo "  未登录（没有 auth.json）"
  fi
  if [ -f "$STORE_DIR/previous.auth.json" ]; then
    echo "上次切换前的备份：$STORE_DIR/previous.*（account_id=$(aid_of "$STORE_DIR/previous.auth.json")）"
  fi
}

cmd_delete() {
  [ $# -eq 1 ] || die "用法：codex-switch delete <名字>"
  local name="$1"
  local d="$PROFILES_DIR/$name"
  [ -d "$d" ] || die "profile「${name}」不存在"
  rm -rf "$d"
  [ -f "$CURRENT_FILE" ] && [ "$(cat "$CURRENT_FILE")" = "$name" ] && rm -f "$CURRENT_FILE"
  echo "已删除 profile「${name}」"
}

cmd_sessions() {
  local db="$CODEX_HOME/state_5.sqlite"
  [ -f "$db" ] || die "找不到会话数据库 $db"
  python3 - "$db" "$CONFIG_FILE" <<'PY'
import sqlite3, sys, re
db, cfg = sys.argv[1], sys.argv[2]
prov = "openai"
try:
    for line in open(cfg, encoding="utf-8"):
        m = re.match(r'\s*model_provider\s*=\s*"([^"]+)"', line)
        if m:
            prov = m.group(1)
except OSError:
    pass
con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
cur = con.cursor()
rows = cur.execute("""
    SELECT datetime(updated_at,'unixepoch','localtime'), model_provider, id,
           COALESCE(title,''), source
    FROM threads
    WHERE source IN ('cli','exec','vscode')
    ORDER BY updated_at DESC
""").fetchall()
print(f"当前 provider：{prov}（* = 与当前 provider 一致；无 * 的会话用 codex resume <id> 可跨 provider 恢复）")
for t, mp, tid, title, src in rows:
    title = (title or '').replace('\n', ' ').replace('\r', ' ').replace('\t', ' ').strip()
    mark = "*" if mp == prov else " "
    print(f"{mark} {t}  {mp:<8} {src:<4} {tid}  {title[:48]}")
con.close()
PY
}

cmd_resume() {
  [ $# -ge 1 ] || die "用法：codex-switch resume <标题关键词|会话ID>"
  local kw="$*"
  local db="$CODEX_HOME/state_5.sqlite"
  [ -f "$db" ] || die "找不到会话数据库 $db"
  local out
  out="$(python3 - "$db" "$kw" <<'PY'
import sqlite3, sys, re
db, kw = sys.argv[1], sys.argv[2].lower()
# 输入像会话 ID（十六进制/连字符，≥8 位）就按 id 前缀匹配，否则按标题关键词
by_id = re.fullmatch(r'[0-9a-f-]{8,}', kw) is not None
con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
cur = con.cursor()
if by_id:
    rows = cur.execute("""
        SELECT id, COALESCE(title,''), model_provider,
               datetime(updated_at,'unixepoch','localtime')
        FROM threads
        WHERE source IN ('cli','vscode') AND lower(id) LIKE ?
        ORDER BY updated_at DESC
    """, (kw + '%',)).fetchall()
else:
    rows = cur.execute("""
        SELECT id, COALESCE(title,''), model_provider,
               datetime(updated_at,'unixepoch','localtime')
        FROM threads
        WHERE source IN ('cli','vscode') AND lower(COALESCE(title,'')) LIKE ?
        ORDER BY updated_at DESC
    """, (f"%{kw}%",)).fetchall()
for r in rows:
    rid, title, provider, t = r
    title = (title or '').replace('\n', ' ').replace('\r', ' ').replace('\t', ' ').strip()
    if len(title) > 60:
        title = title[:57] + '...'
    print("\t".join((rid, title, provider, t)))
con.close()
PY
)"
  if [ -z "$out" ]; then
    die "没有匹配「${kw}」的会话（按标题或 ID；codex-switch sessions 可看全部）"
  fi
  local n; n="$(printf '%s\n' "$out" | wc -l)"
  if [ "$n" -gt 1 ]; then
    echo "匹配到 $n 条，请输入更精确的关键词或更长的 ID 前缀："
    printf '%s\n' "$out" | awk -F'\t' '{printf "  %s  %-8s  %s  %s\n", $4, $3, $1, $2}'
    exit 1
  fi
  local id; id="$(printf '%s\n' "$out" | cut -f1)"
  echo "恢复会话：$(printf '%s\n' "$out" | awk -F'\t' '{print $3" | "$4" | "$2}')"
  command -v codex >/dev/null 2>&1 || die "找不到 codex 命令"
  # 用当前 provider/model 恢复（-c 覆盖会把会话重新指向当前 provider，实现双向切换）
  local prov model
  prov="$(cfg_provider "$CONFIG_FILE")"; [ "$prov" = "?" ] && prov="openai"
  model="$(cfg_model "$CONFIG_FILE")"
  if [ -n "$model" ] && [ "$model" != "?" ]; then
    exec codex resume "$id" -c "model_provider=\"$prov\"" -c "model=\"$model\""
  else
    exec codex resume "$id" -c "model_provider=\"$prov\""
  fi
}

cmd_run() {
  [ $# -ge 1 ] || die "用法：codex-switch run <名字> [codex 参数...]"
  local name="$1"; shift
  local src="$PROFILES_DIR/$name"
  [ -f "$src/auth.json" ] || die "profile「${name}」不存在（可用 codex-switch list 查看）"
  command -v codex >/dev/null 2>&1 || die "找不到 codex 命令"

  local home="$HOMES_DIR/$name"
  local auth_written=""
  mkdir -p "$home"

  # 每账号独立的真实文件：auth.json + config.toml
  # auth.json：独立 home 里已有且比 profile 新，说明是上一次运行期间刷新轮换过的活 token，
  # 沿用并回写 profile，避免新终端拿到被轮换作废的旧 token（免重复登录）。
  if [ -f "$home/auth.json" ] && [ "$home/auth.json" -nt "$src/auth.json" ]; then
    cp "$home/auth.json" "$src/auth.json"
    echo "沿用独立 home 里较新的登录态（已回写 profile）"
  else
    cp "$src/auth.json" "$home/auth.json"
    auth_written=1
  fi
  [ -f "$src/config.toml" ] && cp "$src/config.toml" "$home/config.toml"

  # 其余全部软链到共享的 ~/.codex（会话记录、包、插件、skills 等），保证历史互通
  local item base
  for item in "$CODEX_HOME"/* "$CODEX_HOME"/.[!.]*; do
    [ -e "$item" ] || continue
    base="$(basename "$item")"
    case "$base" in
      auth.json|config.toml) continue ;;
      app-server-*|.tmp|tmp|thread-writer-locks|shell_snapshots|.sandbox_migration) continue ;;
      backup-*|config.toml.zipwuu.bak) continue ;;
      *-wal|*-shm) continue ;;
    esac
    rm -rf "$home/$base"
    ln -s "$item" "$home/$base"
  done

  # 清掉旧版本脚本可能遗留的 app-server-* / .tmp 软链（会让 codex 启动报 daemon 目录冲突），
  # 让被旧版本污染的 home 自愈。只删软链，不动 codex 自己创建的目录。
  find "$home" -maxdepth 1 \( -name 'app-server-*' -o -name '.tmp' \) -type l -exec rm -f {} + 2>/dev/null || true

  # 本次 run 刚重写了 home 的 auth.json，而该 home 已有旧 daemon 在跑：
  # daemon 只在启动时读过一次 auth.json，内存里还是旧 token，TUI 会继续弹登录页。
  local dp
  if [ -n "$auth_written" ]; then
    dp="$(home_daemon_pids "$home" | head -1)"
    if [ -n "$dp" ]; then
      echo "警告：「${name}」的 home 里有旧 app-server daemon（PID ${dp}）还在用旧登录态，本次 run 可能弹登录页。"
      echo "      建议先执行：codex-switch daemon-restart ${name}"
    fi
  fi

  echo "用「${name}」独立 CODEX_HOME 启动 codex → $home"
  CODEX_HOME="$home" exec codex "$@"
}

cmd_sync() {
  [ $# -eq 1 ] || die "用法：codex-switch sync <名字>"
  local name="$1"
  local home="$HOMES_DIR/$name"
  local src="$home/auth.json"
  [ -f "$src" ] || die "找不到独立 home 的登录态 ${src}（先 codex-switch run ${name} 运行过一次）"

  # 还有进程在用这个 home 时提醒：它们继续刷新会轮换 token，
  # 回写后若新终端也共用这条会话，两边会互相顶掉对方。
  local live=""
  live="$(pgrep -f "$home" 2>/dev/null | head -3 || true)"
  if [ -n "$live" ]; then
    echo "警告：仍有进程在用 ${home}（比如正在运行的 agent）。"
    echo "      它们继续刷新会轮换 token；并发的新终端请使用单独登录的 profile，不要共用这条会话。"
  fi

  local d="$PROFILES_DIR/$name"
  mkdir -p "$d"
  cp "$src" "$d/auth.json"
  [ -f "$home/config.toml" ] && cp "$home/config.toml" "$d/config.toml"
  echo "已把独立 home 的登录态回写进 profile「${name}」  account_id=$(aid_of "$src")  mode=$(mode_of "$src")"
}

cmd_daemon_restart() {
  [ $# -eq 1 ] || die "用法：codex-switch daemon-restart <名字>"
  local name="$1"
  local home="$HOMES_DIR/$name"
  [ -d "$home" ] || die "没有找到「${name}」的独立 home：${home}（先 codex-switch run ${name} 运行过一次）"

  local pids
  pids="$(home_daemon_pids "$home")"
  if [ -z "$pids" ]; then
    echo "「${name}」的 home 没有检测到在运行的 app-server daemon。"
    echo "下次 codex-switch run ${name} 会启动全新 daemon 并读取磁盘上的最新登录态，无需重启。"
    return 0
  fi

  echo "检测到「${name}」的 home 还有旧 daemon 在运行（PID: $(printf '%s' "$pids" | tr '\n' ' ')）。"
  echo "它缓存的是旧登录态；relogin/sync 之后继续用它，run 时可能仍弹登录页。正在停掉……"
  # 先走官方 stop 清理它自己的状态，再兜底结束残留的 daemon / 孤儿 updater
  if command -v codex >/dev/null 2>&1; then
    CODEX_HOME="$home" codex app-server daemon stop >/dev/null 2>&1 || true
  fi
  sleep 1
  local left
  left="$(home_daemon_pids "$home")"
  if [ -n "$left" ]; then
    echo "官方 stop 后仍有残留进程（PID: $(printf '%s' "$left" | tr '\n' ' ')），直接结束……"
    kill $left 2>/dev/null || true
    sleep 1
    left="$(home_daemon_pids "$home")"
    if [ -n "$left" ]; then
      echo "仍有进程未退出（PID: $(printf '%s' "$left" | tr '\n' ' ')），请手动结束：kill $(printf '%s' "$left" | tr '\n' ' ')" >&2
      exit 1
    fi
  fi
  echo "旧 daemon 已全部停掉。下次 codex-switch run ${name} 会带着最新登录态启动。"
}

case "${1:-help}" in
  save)     shift; cmd_save "$@" ;;
  use)      shift; cmd_use "$@" ;;
  relogin)  shift; cmd_relogin "$@" ;;
  list)     cmd_list ;;
  sessions) cmd_sessions ;;
  resume)   shift; cmd_resume "$@" ;;
  run)      shift; cmd_run "$@" ;;
  sync)     shift; cmd_sync "$@" ;;
  daemon-restart) shift; cmd_daemon_restart "$@" ;;
  status)   cmd_status ;;
  delete)   shift; cmd_delete "$@" ;;
  help|-h|--help) cmd_help ;;
  *) cmd_help; exit 1 ;;
esac
